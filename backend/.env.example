# copy to .env
POSTGRES_PASSWORD=postgres
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
# 32 url-safe base64 bytes: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CORS_ORIGINS=*

# host port for the API, Swagger (/docs) and the UI pages
API_PORT=8031
# crawl defaults (each competitor can override them)
BROWSER=auto
BROWSER_PAGES=30
AI_EXTRACT=true

# The browser (Chromium) for pages built by JavaScript can run on another machine, e.g. your own computer:
#   on that computer: docker compose up -d browser   (needs BROWSER_SERVER_SECRET)
#   where the worker runs: BROWSER_WS_URL=ws://<that computer's IP>:3000/<the same secret>
# Everything on one computer: BROWSER_WS_URL=ws://browser:3000/<secret> and `docker compose up -d`.
# Empty BROWSER_WS_URL: the worker launches Chromium itself (local development with Chrome installed).
# secret: python -c "import secrets; print(secrets.token_urlsafe(24))"
BROWSER_SERVER_SECRET=
BROWSER_WS_URL=
BROWSER_PORT=3000
