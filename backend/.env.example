# copy to .env
POSTGRES_PASSWORD=postgres
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
# 32 url-safe base64 bytes: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CORS_ORIGINS=*

# host port for the API, Swagger (/docs) and the UI pages
API_PORT=8031
# crawl defaults (each competitor can override them)
BROWSER=auto
BROWSER_PAGES=30
AI_EXTRACT=true
